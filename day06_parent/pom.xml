<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wcy</groupId>
    <artifactId>day06_parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>


    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            自定义标签
        -->
        <lombok.version>1.18.38</lombok.version>
        <hutool.version>5.8.44</hutool.version>
        <spring.boot.version>3.5.16</spring.boot.version>
        <mysql.version>8.0.33</mysql.version>
    </properties>

    <!--    模块整合-->
    <modules>
        <module>../day06_test01</module>
        <module>../day06_test02</module>
        <module>../day06_test03</module>
    </modules>

    <!--
        依赖标签
    -->
    <!--
        添加依赖管理标签
        依赖管理只是管理,但是并不会添加依赖
    -->
    <dependencyManagement>
        <dependencies>
            <!--依赖标签:引入一个依赖-->
            <dependency>
                <groupId>org.projectlombok</groupId> <!--组织名-->
                <artifactId>lombok</artifactId><!--项目名-->
                <version>${lombok.version}</version><!--版本号-->
            </dependency>

            <!--hutool依赖-->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!--spring boot test依赖-->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${spring.boot.version}</version>
            </dependency>

            <!-- mysql版本-->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--依赖标签:引入一个依赖-->
        <dependency>
            <groupId>org.projectlombok</groupId> <!--组织名-->
            <artifactId>lombok</artifactId><!--项目名-->
        </dependency>

        <!--hutool依赖-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!--spring boot test依赖-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>

        <!--
            mysql的依赖
        -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
    </dependencies>

</project>